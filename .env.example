# Backend (local)
PORT=5000

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Shared secret used by the web UI and CLI. Keep in sync with the frontend token.
AGENT_SECRET_TOKEN=2005

# PostgreSQL connection string (Render Postgres).
# Use the External URL for local testing, Internal URL inside Render.
DATABASE_URL=postgresql://user:password@host:5432/dbname
